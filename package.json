{
  "name": "openprofile",
  "version": "5.1.0-beta-build-e1ffd75",
  "description": "OpenProfile is a free original character database and collaboration platform made by and for writers.",
  "keywords": [
    "original character database",
    "OC database",
    "writing collaboration",
    "character creation tool",
    "worldbuilding platform",
    "roleplaying character storage",
    "digital character sheet",
    "OC management tool",
    "collaborative storytelling"
  ],
  "author": "OpenProfile",
  "license": "OPPL",
  "type": "module",
  "scripts": {
    "start": "pm2 start ecosystem.config.cjs && pm2 monit",
    "dev": "pm2 start dev.ecosystem.config.cjs && pm2 monit",
    "stop": "pm2 stop all && pm2 kill",
    "sandbox": "tsx sandbox/%npm_config_name%.test.ts",
    "backup": "tsx dev/backup.ts",
    "update": "npm update --force && cd src-tauri && cargo update && cd ../",
    "build": "tsx dev/node/buildApp.mts",
    "clean": "rimraf dist && rimraf logs",
    "sync": "tsx dev/syncConfig.ts",
    "translate": "tsx dev/translateLocales.ts",
    "minify": "npx esbuild \"dist/**/*.js\" --format=esm --minify --banner:js=\"/* This file is part of OpenProfile. Copyright © 2017-2026 OpenProfile™. All rights reserved. */\" --outdir=dist --allow-overwrite",
    "copy:ssl": "cpx ssl/**/* dist/ssl",
    "copy:public": "cpx public/**/* dist/public",
    "copy:package": "cpx package.json dist",
    "copy:env": "cpx .env dist",
    "copy:ecosystem": "cpx ecosystem.config.cjs dist",
    "publish:npm": "cd packages/node && npm publish && cd ../../",
    "build:npm": "cd packages/node && tsx ../../dev/node/buildNodePackage.mts && cd ../../",
    "dev:app": "tauri dev",
    "build:app:windows": "tauri build --target x86_64-pc-windows-msvc --no-bundle",
    "build:app:linux": "tauri build --target x86_64-unknown-linux-gnu",
    "package:app:windows": "cmd /c \"\"C:\\Program Files (x86)\\Inno Setup 6\\ISCC.exe\" inno.iss\"",
    "init": "npm install --force && npm install -g pm2 && shx cp .env.example .env && shx mv ssl/dev.crt.example ssl/dev.crt && shx mv ssl/dev.key.example ssl/dev.key && shx mv ssl/prod.crt.example ssl/prod.crt && shx mv ssl/prod.key.example ssl/prod.key && rimraf --glob \"**/DELETE_ME\" && npm run update"
  },
